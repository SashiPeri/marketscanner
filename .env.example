# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MARKET_PROVIDER: Selects the market data source ("mock", "sierra" or "acsil").
# Defaults to "mock" for local development without Sierra Chart.
# "sierra" = DTC protocol server (note: CME futures are refused by Sierra
# over DTC — see docs/SIERRA_LIVE_DATA_FIX.md).
# "acsil" = in-process bridge study (acsil/MarketScannerBridge.cpp) — the
# path for live CME futures from your Denali feed. Study dials into ACSIL_PORT.
MARKET_PROVIDER="mock"

# Sierra Chart DTC connection settings (used when MARKET_PROVIDER=sierra).
SIERRA_HOST="127.0.0.1"
SIERRA_PORT="11099"
SIERRA_USERNAME=""
SIERRA_PASSWORD=""

# ACSIL bridge listen port (used when MARKET_PROVIDER=acsil).
# The study (Study Settings >> Scanner host/port) dials OUT to this port.
# Must be reachable from the Windows host (e.g. 10.0.2.15 in VirtualBox NAT).
ACSIL_PORT="18199"

# Persistence: "memory" (testing) or "json" (default).
PERSISTENCE_MODE="json"
DATA_DIR="data"

# Logging
LOG_LEVEL="info"

# Application metadata
APP_VERSION="0.0.0"
BUILD_TIMESTAMP=""

# Realtime tuning
BATCH_INTERVAL_MS="50"
SHUTDOWN_TIMEOUT_MS="10000"
